# Supabase (required for production — omit for local demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Either classic anon key OR new publishable key (from Connect dialog)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional — used for metadata / password-reset redirects
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3421
